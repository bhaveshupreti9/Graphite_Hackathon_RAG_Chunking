# Copy to .env in the project root (next to requirements.txt). Every value is optional.

# Language model (any OpenAI-compatible API). Without these, chat returns 503 LLM_NOT_CONFIGURED,
# summaries are skipped with a warning, and the session summary uses a simple built-in recap.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embeddings: "sentence-transformers" (default, downloads all-MiniLM-L6-v2 once, ~90 MB)
# or "hash" (offline, fast, poor retrieval quality; for tests and machines without internet).
EMBEDDING_BACKEND=sentence-transformers

# Prompt budget shown in the chat token meter.
CONTEXT_WINDOW_LIMIT=8192

# Comma-separated origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# Storage locations (defaults shown).
# DATA_DIR=data
# OUTPUTS_DIR=outputs
# CHROMA_PATH=chroma_db
# SAMPLES_DIR=data/samples
# EVAL_RESULTS=eval/results.json
MAX_UPLOAD_MB=20

# Accounts: set to false to turn login off (everyone shares the "guest" account).
AUTH_REQUIRED=true
