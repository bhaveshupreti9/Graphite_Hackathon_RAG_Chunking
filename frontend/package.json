    "@react-three/fiber": "^8.17.10",
    "framer-motion": "^11.11.0",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.9",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0",
    "three": "^0.169.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
